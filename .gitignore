# =============================================================================
# CachyOS-Boot-Rescue - Root .gitignore
# =============================================================================
# This file excludes generated files, build artifacts, IDE configs, and
# AI-agent-specific files that should not be committed to version control.
# Documentation (AGENTS.md, CURRENT_STATUS.md, START_HERE.md, Docs/) is KEPT.
# Source code (Sources/) is KEPT.
# =============================================================================

# -----------------------------------------------------------------------------
# Graphify / Knowledge Graph outputs (generated by /graphify command)
# -----------------------------------------------------------------------------
graphify-out/
.graphify_*

# -----------------------------------------------------------------------------
# Rust / Cargo build artifacts (from Sources/cachy-chroot)
# -----------------------------------------------------------------------------
Sources/cachy-chroot/target/
**/target/

# -----------------------------------------------------------------------------
# IDE / Editor configurations
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.vs/
*.code-workspace
# Keep: Sources/cachy-chroot/Cachy Choot.code-workspace (part of source)

# -----------------------------------------------------------------------------
# OS / Filesystem metadata
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.lnk

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.cache
.tmp/
.temp/
.cache/

# -----------------------------------------------------------------------------
# Python / Virtual environments (if any)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -----------------------------------------------------------------------------
# Node.js / npm (if any)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# AI Agent / LLM specific exclusions
# -----------------------------------------------------------------------------
# OpenCode / opencode skills and local config
.opencode/
.opencode/**/*
# Keep: AGENTS.md (project rules for AI agents)

# opencode skills lock file (local skill installations)
skills-lock.json
*.skills.lock.json

# Local skills that could affect AI agent behavior
skills/
.local-skills/
.ai-skills/

# .agents directory (AI agent configs and skills)
.agents/

# MCP servers local config
.mcp.json
.mcp/

# Cursor / Windsurf / other AI IDE local state
.cursor/
.windsurf/
.continue/

# -----------------------------------------------------------------------------
# Secrets / Credentials (never commit)
# -----------------------------------------------------------------------------
*.env
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
*.kdbx

# -----------------------------------------------------------------------------
# Test / Coverage outputs
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*
*.lcov
test-results/
*.trx
junit.xml

# -----------------------------------------------------------------------------
# Docker / Container
# -----------------------------------------------------------------------------
.docker/
docker-compose.override.yml

# -----------------------------------------------------------------------------
# Backup / Archive files
# -----------------------------------------------------------------------------
*.bak
*.backup
*.old
*.orig
*.swp
*~
*.tar.gz
*.zip
*.rar
*.7z

# -----------------------------------------------------------------------------
# Language-specific: Shell scripts
# -----------------------------------------------------------------------------
# No specific build artifacts for shell, but keep sources

# -----------------------------------------------------------------------------
# Do NOT ignore (explicitly kept):
# -----------------------------------------------------------------------------
# !AGENTS.md
# !CURRENT_STATUS.md
# !START_HERE.md
# !Docs/
# !Sources/
# !Sources/cachy-chroot/
# !Sources/cachy-chroot/src/
# !Sources/cachy-chroot/Cargo.toml
# !Sources/cachy-chroot/Cargo.lock
# !Sources/cachy-chroot/build.rs
# !Sources/cachy-chroot/rustfmt.toml
# !Sources/cachy-chroot/README.md
# !Sources/cachy-chroot/LICENSE
# !Sources/cachy-chroot/.gitignore
# !Sources/cachyos-bootloader-switcher/
# !Sources/cachyos-bootloader-switcher/bootloader-switcher.sh
# !Sources/cachyos-bootloader-switcher/lib/
# !Sources/cachyos-bootloader-switcher/tests/
# !Sources/cachyos-bootloader-switcher/README.md
# !Sources/cachyos-bootloader-switcher/LICENSE